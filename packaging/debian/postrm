#!/bin/sh
# Ember: remove leftovers dpkg doesn't own. User files are removed by `ember-install --uninstall`.
set -e
if [ "$1" = "purge" ] || [ "$1" = "remove" ]; then
    rmdir /usr/libexec/ember 2>/dev/null || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
fi
exit 0
